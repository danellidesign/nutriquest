@startuml
skinparam backgroundColor #FFFFFF
skinparam activity {
    BackgroundColor #f8f9fa
    BorderColor #0056b3
    ArrowColor #0056b3
}
skinparam swimlane {
    BorderColor #888888
    TitleBackgroundColor #E6F2FF
    TitleFontColor #333333
}

title Aktivitätsdiagramm: Prozess "Mahlzeit erfassen inkl. Quest-Fortschritt"

|#FFF9E6|Benutzer (Client UI)|
start
:Klickt auf "Barcode Scannen";
:Hält Produkt vor die Kamera;

|#E6F2FF|Systemlogik (Client & Server)|
:Kamera-Stream aktivieren &
EAN-Barcode dekodieren;
:HTTP POST /api/scan senden;

|#F0F4F8|Externe API & Datenbank|
:Open Food Facts API abfragen;

if (Produkt gefunden?) then (ja)
    :Nährwertangaben extrahieren;
else (nein)
    |#E6F2FF|Systemlogik (Client & Server)|
    :Fehlermeldung ausgeben;
    stop
endif

|#FFF9E6|Benutzer (Client UI)|
:Grammanzahl eintragen;

|#E6F2FF|Systemlogik (Client & Server)|
:Kalorien & XP berechnen;
if (XP >= 1000?) then (ja)
    :Level erhöhen (Level++);
    |#FFF9E6|Benutzer (Client UI)|
    :Level-Up Alert ausgeben;
    |#E6F2FF|Systemlogik (Client & Server)|
else (nein)
endif

:Parallele Datensicherung initiieren;

fork
    |#F0F4F8|Externe API & Datenbank|
    :User-Stammdaten aktualisieren;
fork again
    |#F0F4F8|Externe API & Datenbank|
    :Mahlzeit historisch eintragen
    (inkl. Snapshot "target_kcal");
end fork

|#E6F2FF|Systemlogik (Client & Server)|
:Ring-Chart & Tagebuchliste berechnen;

:Tagesquest-Fortschritt live
vom Server abfragen & auswerten;

|#FFF9E6|Benutzer (Client UI)|
:Aktualisiertes Dashboard anzeigen
(Restkalorien, Mahlzeiten & Quest-Balken);

stop
@enduml